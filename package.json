{
  "name": "spin",
  "productName": "Spin",
  "version": "1.5.0",
  "description": "A minimal, very personal music player for your music folder. Spin the record to seek.",
  "author": "Spin contributors",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/smoke.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "local.spin.player",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSAppleMusicUsageDescription": "Spin plays the music files in the folder you choose."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Audio",
      "icon": "build/icon.png",
      "executableName": "spin",
      "synopsis": "A minimal, very personal music player",
      "maintainer": "Spin contributors <noreply@example.com>"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1"
  },
  "license": "MIT",
  "homepage": "https://example.com/replace-with-your-repo-url"
}
